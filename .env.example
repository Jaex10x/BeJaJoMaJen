# Copy this file to ".env" and fill in your key. Never commit .env.
# On a host like Vercel, set these as environment variables in the dashboard instead.

# Required. Get a key at https://aistudio.google.com/apikey
# It stays on the server: it is never sent to the browser.
GEMINI_API_KEY=

# Optional: any Gemini model your key can use. flash-lite answers in ~1-5 s and works on the
# free tier. gemini-3.5-flash / gemini-3.8-flash are smarter but much slower (they "think"
# first) and are often overloaded on the free tier. Older models (e.g. gemini-2.5-flash)
# are no longer available to new API keys.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: comma-separated models to try when GEMINI_MODEL is overloaded, rate-limited or slow
# (free-tier capacity and quotas are per model). Empty = no fallback.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Strongly recommended (required in production). Signs the session cookie AND the
# conversation-history tokens. If unset, a random key is used and every restart (or every
# serverless instance) forgets all chats. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional tuning (defaults shown)
# GEMINI_TIMEOUT_MS=30000          # per request
# GEMINI_MAX_OUTPUT_TOKENS=4096    # "thinking" tokens count here too
# GEMINI_THINKING_LEVEL=low        # minimal | low | medium | high; empty = model default (slower)
# GEMINI_HISTORY_MESSAGES=20       # how many earlier messages Gemini sees (10 exchanges)
# GEMINI_HISTORY_CHARS=16000       # ...capped at this much text

# Set to 1 when served over HTTPS (e.g. on Vercel) so the session cookie is HTTPS-only
# SESSION_COOKIE_SECURE=1
